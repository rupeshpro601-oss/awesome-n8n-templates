{
  "name": "100% Autonomous YouTube AI Publisher (Fixed)",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [{ "mode": "every10Minutes" }]
        }
      },
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "path": "/videos/incoming",
        "options": {
          "extensions": "mp4"
        }
      },
      "name": "Read Videos",
      "type": "n8n-nodes-base.readBinaryFiles",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "name": "Split Batch",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "content": "You are an elite YouTube SEO expert. Return ONLY valid JSON. No markdown."
          },
          {
            "role": "user",
            "content": "Generate high-CTR YouTube metadata.\n\nFilename: {{$binary.data.fileName}}\nNiche: Faceless motivational videos\nAudience: Men 18-35\nTone: Confident, cinematic\nGoal: Maximize CTR and retention\n\nReturn JSON:\n{\n  \"title\": \"\",\n  \"description\": \"\",\n  \"tags\": []\n}"
          }
        ]
      },
      "name": "AI Metadata",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [800, 300],
      "credentials": {
        "openAiApi": {
          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const BASE_HOUR = 18;\nconst now = new Date();\nlet publish = new Date(now);\npublish.setHours(BASE_HOUR, 0, 0, 0);\nif (publish <= now) publish.setDate(publish.getDate() + 1);\n\nlet ai;\ntry {\n  const content = items[0].json?.choices?.[0]?.message?.content;\n  if (!content) throw new Error('Missing AI content');\n  ai = JSON.parse(content);\n} catch (e) {\n  const fallbackTitle = items[0].binary.data.fileName.replace(/\\.mp4$/i, '').replace(/[_-]/g, ' ');\n  ai = {\n    title: fallbackTitle,\n    description: `Motivational video: ${fallbackTitle}`,\n    tags: fallbackTitle.split(' ')\n  };\n}\n\nreturn [{\n  title: ai.title,\n  description: ai.description,\n  tags: ai.tags.join(','),\n  publishAt: publish.toISOString(),\n  filePath: `/videos/incoming/${items[0].binary.data.fileName}`\n}];"
      },
      "name": "Prepare Upload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "binaryProperty": "data",
        "title": "={{$json.title}}",
        "description": "={{$json.description}}",
        "additionalFields": {
          "tags": "={{$json.tags}}",
          "privacyStatus": "private",
          "publishAt": "={{$json.publishAt}}"
        }
      },
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.youtube",
      "typeVersion": 1,
      "position": [1200, 300],
      "credentials": {
        "youtubeOAuth2Api": {
          "name": "YouTube OAuth2"
        }
      }
    },
    {
      "parameters": {
        "sourcePath": "={{$json.filePath}}",
        "destinationPath": "={{`/videos/posted/${$binary.data.fileName}`}}"
      },
      "name": "Archive Video",
      "type": "n8n-nodes-base.moveBinaryFile",
      "typeVersion": 1,
      "position": [1400, 300]
    }
  ],
  "connections": {
    "Cron": {
      "main": [[{ "node": "Read Videos", "type": "main" }]]
    },
    "Read Videos": {
      "main": [[{ "node": "Split Batch", "type": "main" }]]
    },
    "Split Batch": {
      "main": [[{ "node": "AI Metadata", "type": "main" }]]
    },
    "AI Metadata": {
      "main": [[{ "node": "Prepare Upload", "type": "main" }]]
    },
    "Prepare Upload": {
      "main": [[{ "node": "Upload to YouTube", "type": "main" }]]
    },
    "Upload to YouTube": {
      "main": [[{ "node": "Archive Video", "type": "main" }]]
    }
  },
  "active": false
    }
